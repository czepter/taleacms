<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnSkippedTests="true">
    <testsuites>
        <!-- no database, milliseconds -->
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <!-- a real MySQL 8 (docker-compose-dev.yaml service db-test, 127.0.0.1:33061) or PostgreSQL 18 (db-test-pg, 127.0.0.1:33062), by TALEA_TEST_DB_DRIVER; skipped when it is not reachable -->
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <!-- whole sites installed per test class, driven over HTTP; slow (seconds per class), parallel with ParaTest -->
        <testsuite name="site"><directory>tests/Site</directory></testsuite>
        <!-- Chrome walk of a clean install (Node, Chrome, network for playwright-core); skipped when unavailable -->
        <testsuite name="browser"><directory>tests/Browser</directory></testsuite>
        <!-- docker compose: boots image N, updates to N+1 (HF-13); skipped without Docker; slow, so `composer test` excludes the group -->
        <testsuite name="e2e"><directory>tests/E2E</directory></testsuite>
        <!-- the older tools/unit-tests.php (custom check() harness) run as one test until its checks move into tests/ -->
        <testsuite name="legacy"><directory>tests/Legacy</directory></testsuite>
    </testsuites>
    <source>
        <include><directory>system/src</directory></include>
    </source>
    <php>
        <!-- the engine the integration and site suites run against: mysql (default) or pgsql (composer test:pg) -->
        <env name="TALEA_TEST_DB_DRIVER" value="mysql" force="false"/>
        <env name="TALEA_TEST_PG_HOST" value="127.0.0.1" force="false"/>
        <env name="TALEA_TEST_PG_PORT" value="5433" force="false"/>
        <env name="TALEA_TEST_PG_USER" value="postgres" force="false"/>
        <env name="TALEA_TEST_PG_PASSWORD" value="postgres" force="false"/>
        <env name="TALEA_TEST_DB_HOST" value="127.0.0.1" force="false"/>
        <env name="TALEA_TEST_DB_PORT" value="33061" force="false"/>
        <env name="TALEA_TEST_DB_USER" value="root" force="false"/>
        <env name="TALEA_TEST_DB_PASSWORD" value="root" force="false"/>
    </php>
</phpunit>

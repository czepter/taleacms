{
    "name": "talea/talea",
    "description": "Self-hosted website builder (a fork of Talea).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "robmorgan/phinx": "0.16.12"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "brianium/paratest": "^7.26",
        "phpunit/phpunit": "^13.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Talea\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "paratest --processes 6 --exclude-group browser",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:site": "paratest --testsuite site --processes 6",
        "test:browser": "phpunit --testsuite browser",
        "test:legacy": "phpunit --testsuite legacy"
    },
    "scripts-descriptions": {
        "test": "All suites, six processes in parallel (needs the db-test service)",
        "test:unit": "Unit tests, no database",
        "test:integration": "Tests against MySQL 8 (db-test service)",
        "test:site": "Whole installed sites over HTTP, one class per site, in parallel",
        "test:browser": "Chrome walk of a clean install (needs Node, Chrome, network)",
        "test:legacy": "The older tools/unit-tests.php"
    }
}

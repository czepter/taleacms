{
    "version": 2,
    "supported": [
        1,
        2
    ],
    "methods": {
        "adminPage": [
            "string $name",
            "string $title",
            "callable $render"
        ],
        "app": [],
        "earlyRequest": [
            "callable $hook"
        ],
        "eventType": [
            "string $type",
            "string $description",
            "bool $alert"
        ],
        "filter": [
            "string $name",
            "callable $filter"
        ],
        "get": [
            "string $key",
            "string $default"
        ],
        "handoverFindings": [
            "callable $findings"
        ],
        "healthRows": [
            "callable $rows"
        ],
        "httpGet": [
            "string $url",
            "int $timeout",
            "int $maxBytes"
        ],
        "job": [
            "string $name",
            "int $interval",
            "string $label",
            "callable $run",
            "string $runner"
        ],
        "mcpTool": [
            "string $name",
            "string $description",
            "array $schema",
            "string $access",
            "callable $handler",
            "string $requires"
        ],
        "on": [
            "string $eventType",
            "callable $listener"
        ],
        "set": [
            "string $key",
            "string $value"
        ],
        "settings": [
            "array $schema",
            "string $title",
            "?callable $extra"
        ],
        "token": [
            "string $name",
            "callable $render"
        ]
    },
    "v2_methods": [
        "earlyRequest",
        "eventType",
        "handoverFindings",
        "healthRows",
        "httpGet",
        "settings"
    ],
    "filters": [
        "head",
        "footer",
        "page.html"
    ],
    "tool_access": [
        "read",
        "draft",
        "write",
        "destructive"
    ],
    "runners": [
        "any",
        "cron"
    ],
    "capabilities": [
        "early_request",
        "tables",
        "outgoing_requests",
        "mail"
    ]
}
